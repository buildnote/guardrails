{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.18.4",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "aws-access-token",
              "name": "aws-access-token",
              "shortDescription": { "text": "Identified a pattern that may indicate AWS credentials." }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": { "text": "aws-access-token has detected a secret in service/src/main/resources/application.yaml." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "service/src/main/resources/application.yaml" },
                "region": {
                  "startLine": 14,
                  "endLine": 14,
                  "startColumn": 18,
                  "endColumn": 58,
                  "snippet": { "text": "REDACTED" }
                }
              }
            }
          ],
          "partialFingerprints": { "commitSha": "3f2a1c9d4b6e8a0c2d4f6a8b0c2e4f6a8b0c2e4f", "email": "dana@example.com" }
        }
      ]
    }
  ]
}
