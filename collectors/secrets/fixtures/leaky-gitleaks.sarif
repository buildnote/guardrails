{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {"driver": {
        "name": "gitleaks",
        "rules": [{"id": "generic-api-key", "properties": {"tags": ["%(secret)s"]}}]
      }},
      "results": [
        {
          "ruleId": "generic-api-key",
          "level": "error",
          "message": {"text": "generic-api-key has detected a secret in config/app.yaml."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "config/app.yaml"},
                "region": {"startLine": 12, "snippet": {"text": "%(secret)s"}}
              }
            }
          ],
          "partialFingerprints": {"secretHash": "%(secret)s"}
        }
      ]
    }
  ]
}
