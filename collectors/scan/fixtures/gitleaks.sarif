{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "version": "8.18.4",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "aws-access-token",
              "name": "aws-access-token",
              "shortDescription": { "text": "Identified a pattern that may indicate AWS credentials" }
            },
            {
              "id": "generic-api-key",
              "name": "generic-api-key",
              "shortDescription": { "text": "Detected a generic API key" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": { "text": "aws-access-token has detected secret for file deploy/bootstrap.sh at commit 9f3c1ab." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "deploy/bootstrap.sh" },
                "region": { "startLine": 14, "startColumn": 11, "endLine": 14, "endColumn": 31 }
              }
            }
          ],
          "partialFingerprints": { "commitSha": "9f3c1ab", "email": "build@company.io" }
        },
        {
          "ruleId": "generic-api-key",
          "level": "error",
          "message": { "text": "generic-api-key has detected secret for file terraform/live/main/main.tf at commit 4ab77de." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "terraform/live/main/main.tf" },
                "region": { "startLine": 63 }
              }
            }
          ]
        }
      ]
    }
  ]
}
