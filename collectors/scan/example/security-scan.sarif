{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "version": "1.86.0",
          "rules": [
            {
              "id": "kotlin.lang.security.insecure-hostname-verifier",
              "properties": { "security-severity": "7.5" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "kotlin.lang.security.insecure-hostname-verifier",
          "level": "error",
          "message": { "text": "Hostname verification is disabled, so any certificate is accepted." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "service/src/main/kotlin/Queue.kt" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
